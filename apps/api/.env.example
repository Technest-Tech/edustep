APP_NAME="EduStep Academy OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_VERSION=development
TRUSTED_PROXIES=

APP_LOCALE=ar
APP_TIMEZONE=Africa/Cairo
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
SEED_ADMIN_PASSWORD=change-me-before-seeding

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
SLOW_REQUEST_THRESHOLD_MS=800

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=edustep
DB_USERNAME=edustep
DB_PASSWORD=edustep_local

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8080

REQUIRE_PRIVILEGED_2FA=false
TWO_FACTOR_ISSUER="EduStep Academy OS"
TWO_FACTOR_CHALLENGE_LIFETIME=5
TWO_FACTOR_SETUP_LIFETIME=10

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

READINESS_REQUIRE_SCHEDULER=false
READINESS_REQUIRE_QUEUE=false
READINESS_REQUIRE_BACKUP=false
READINESS_HEARTBEAT_MAX_AGE=180
READINESS_BACKUP_MAX_AGE_HOURS=26

# BACKUP_PATH=/absolute/private/backup/path
BACKUP_RETENTION_DAYS=30
BACKUP_PROCESS_TIMEOUT=900

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@edustep.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
