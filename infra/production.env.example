APP_NAME="EduStep Academy OS"
APP_ENV=production
APP_KEY=base64:GENERATE_A_UNIQUE_KEY_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://edustepnow.com
APP_VERSION=2026.07.1
APP_LOCALE=ar
APP_TIMEZONE=Africa/Cairo
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

TRUSTED_PROXIES=*
LOG_CHANNEL=stderr
LOG_LEVEL=warning
SLOW_REQUEST_THRESHOLD_MS=800

DB_CONNECTION=pgsql
DB_DATABASE=edustep
DB_USERNAME=edustep
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DB_SSLMODE=disable

REDIS_CLIENT=phpredis
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_REDIS_PASSWORD
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_STORE=redis
QUEUE_CONNECTION=redis

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=edustepnow.com
SANCTUM_STATEFUL_DOMAINS=edustepnow.com,www.edustepnow.com

REQUIRE_PRIVILEGED_2FA=true
TWO_FACTOR_ISSUER="EduStep Academy OS"
TWO_FACTOR_CHALLENGE_LIFETIME=5
TWO_FACTOR_SETUP_LIFETIME=10

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@academy.example.com
MAIL_FROM_NAME="${APP_NAME}"

READINESS_REQUIRE_SCHEDULER=true
READINESS_REQUIRE_QUEUE=true
READINESS_REQUIRE_BACKUP=true
READINESS_HEARTBEAT_MAX_AGE=180
READINESS_BACKUP_MAX_AGE_HOURS=26

BACKUP_PATH=/var/backups/edustep
BACKUP_RETENTION_DAYS=30
BACKUP_PROCESS_TIMEOUT=900

HTTP_PORT=127.0.0.1:8081
